# Optional API keys for supplementary vision models.
# The core feature mapping, VQA, change detection, and fusion paths run locally.

# Optional Gemini assistance (the in-house fallback is used when unset)
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional Anthropic assistance
ANTHROPIC_API_KEY=your_claude_api_key_here

# Optional Hugging Face token for gated local models
HUGGINGFACE_TOKEN=your_hf_token_here

# Optional frontend override, for example http://127.0.0.1:8001
VITE_API_BASE=http://127.0.0.1:8000
