# API Keys for Vision Models
# Copy this to .env and add your actual keys

# Option 1: Groq (RECOMMENDED - Free, Fast, Llama 3.2 Vision 90B)
GROQ_API_KEY=your_groq_api_key_here

# Option 2: Google Gemini (DEPRECATED - Requires OAuth2 as of Sept 2026)
GOOGLE_API_KEY=your_gemini_api_key_here

# Option 3: Anthropic Claude (PAID)
ANTHROPIC_API_KEY=your_claude_api_key_here

# Option 4: Hugging Face (if using gated models)
HUGGINGFACE_TOKEN=your_hf_token_here
